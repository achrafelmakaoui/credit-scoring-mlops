# Copy this file to .env and fill in the values. Never commit .env.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-scoring
MODEL_NAME=credit-scoring
MODEL_ALIAS=champion

# --- DVC remote (DagsHub, S3-compatible) ---
# DagsHub > your repo > Remote > Data > DVC to get these values
DAGSHUB_USER=
DAGSHUB_TOKEN=

# --- API ---
API_PORT=8000
LOG_LEVEL=info

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
